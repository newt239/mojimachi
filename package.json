{
  "name": "mojimachi",
  "version": "2.0.0",
  "private": true,
  "description": "インストールされたフォントを一覧し、掘り下げて見るアプリ",
  "type": "module",
  "scripts": {
    "build": "tauri build",
    "cargo:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "cargo:lint": "cargo fmt --check --manifest-path src-tauri/Cargo.toml && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "cargo:test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "codecheck": "pnpm lint && pnpm test && pnpm cargo:lint && pnpm cargo:test",
    "dev": "tauri dev",
    "format": "oxfmt .",
    "knip": "knip",
    "lint": "oxlint && oxfmt --check . && pnpm typecheck",
    "tauri": "tauri",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "vite:build": "vite build",
    "vite:dev": "vite"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.5",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.0",
    "knip": "^6.37.0",
    "lefthook": "^2.1.14",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.3.1"
}
