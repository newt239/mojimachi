{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "もじまちの既定の権限",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "clipboard-manager:allow-write-text",
    "dialog:default",
    "opener:default",
    "opener:allow-reveal-item-in-dir",
    "os:default",
    "store:default",
    "process:allow-restart",
    "updater:default"
  ]
}
